APP_NAME=ServiciosProNotificaciones
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONNECTION=redis
